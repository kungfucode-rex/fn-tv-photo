    <path
        android:fillColor="#A32C86"
        android:pathData="M106,130l30,-34 22,34z" />

    <!-- the strip, over the bottom of the card stack -->
    <path
        android:fillColor="#FFC24B"
        android:pathData="M0,144h320v36h-320z" />

    <!--
