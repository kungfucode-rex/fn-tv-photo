<?xml version="1.0" encoding="utf-8"?>
<!--
  The debug build's TV banner: the release photo stack in the debug palette, over a
  strip that says DEBUG.

  This is the tile the leanback launcher draws in 我的应用, and the package id is the
  only other difference between the two APKs - so a debug build and a release build of
  the same version used to appear as two identical tiles. The strip is the fix, and it
  is a strip rather than a word floating over the artwork because the launcher draws
  this at whatever size it likes: a solid band keeps the word inside something, so a
  small tile still reads as "this one is different" even when the letters do not.

  Colours are the debug palette from drawable/app_icon_foreground.xml; the geometry is
  the release banner's, unchanged, for the same reason the release banner gives.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="320dp"
    android:height="180dp"
    android:viewportWidth="320"
    android:viewportHeight="180">

    <path
        android:fillColor="#1B1030"
        android:pathData="M0,0h320v180h-320z" />

    <!-- back card -->
    <path
        android:fillColor="#2E1B4D"
        android:pathData="M78,46h150a8,8 0 0 1 8,8v92a8,8 0 0 1 -8,8h-150a8,8 0 0 1 -8,-8v-92a8,8 0 0 1 8,-8z" />

    <!-- middle card -->
    <path
        android:fillColor="#41286B"
        android:pathData="M92,38h150a8,8 0 0 1 8,8v92a8,8 0 0 1 -8,8h-150a8,8 0 0 1 -8,-8v-92a8,8 0 0 1 8,-8z" />

    <!-- front photo -->
    <path
        android:fillColor="#140B22"
        android:pathData="M106,30h150a8,8 0 0 1 8,8v92a8,8 0 0 1 -8,8h-150a8,8 0 0 1 -8,-8v-92a8,8 0 0 1 8,-8z" />

    <!-- sun -->
    <path
        android:fillColor="#FFC24B"
        android:pathData="M232,58m-11,0a11,11 0 1,0 22,0a11,11 0 1,0 -22,0" />

    <!-- mountains -->
