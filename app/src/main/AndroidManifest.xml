<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Settings -> 检测升级 downloads the next APK and opens the system installer on it.
      The permission is what lets Android 8 and up offer that at all; the app cannot
      install anything by itself, and the user still confirms every install on the
      installer's own screen. Nothing else here uses it, and no install is ever silent.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      TV form factor: no touchscreen. leanback is *not* marked required: a TV that
      does not declare android.software.leanback (several Xiaomi/MIUI TV builds) must
      still be allowed to install and list the app. Nothing here is optional at
      runtime — the UI is D-pad only — but the flag gates store filtering, not code.
    -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".TvPhotoApp"
        android:allowBackup="false"
        android:banner="@drawable/app_banner"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="false"
        android:theme="@style/Theme.TvPhoto"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.TvPhoto">
            <!--
              Both launcher categories on purpose.

              LEANBACK_LAUNCHER is what the Android TV / Google TV home screen
              enumerates. The launcher on Chinese TV sets (Xiaomi MIUI TV / PatchWall,
              and most boxes) enumerates the standard LAUNCHER category instead, so an
              APK carrying only the leanback category installs and runs but never
              appears in 我的应用. Declaring both puts the app on either home screen,
              and is what TV apps shipped outside Play do.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Hands a downloaded APK to the system installer.

          The installer is a different process and cannot read this app's files, so the
          file is passed as a content:// URI carrying a one-shot read grant. The authority
          is built from applicationId, which keeps the debug build's copy distinct from
          the release one - the two are installed side by side and would otherwise claim
          the same provider.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
