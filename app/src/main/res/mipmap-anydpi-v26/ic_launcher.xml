<?xml version="1.0" encoding="utf-8"?>
<!--
  The icon an API 26+ launcher loads, home screen and TV home screen alike.

  Two layers, and the mask is the launcher's business: the plate is a flat color
  and the artwork bleeds to the edges, so a circle, a squircle and a rounded
  square all crop it to something that still reads as a landscape with a sun.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/app_icon_foreground" />
</adaptive-icon>
