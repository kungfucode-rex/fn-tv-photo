    <string name="viewer_qr_hint">Scan to comment</string>

    <!-- The 扫码评论 button in the viewer's corner. The label is the *intent* rather than the
         feature's name: somebody standing in front of a photo wants guests to comment on it,
         and "photo review" is what this repository calls the machinery. -->
    <string name="viewer_action_scan">Scan to comment</string>
    <string name="viewer_scan_opened">Comments are on — guests can scan this code</string>
    <string name="settings_review_slideshow_on">Photo review</string>

    <!-- The two words a switch shows. Not Yes/No: these rows turn a *layer* on and off
         rather than answering a question, and On/Off is the plainer reading on a television
         where the value is the only thing visible. -->
    <string name="switch_on">On</string>
    <string name="switch_off">Off</string>

