<?xml version="1.0" encoding="utf-8"?>
<!--
  The NAS is normally reached over plain HTTP on the LAN, and the user picks the
  host (IP or domain) at runtime, so cleartext cannot be scoped to one domain.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
